SQUISHY_HTTP_ADDR=:8080
SQUISHY_PG_DSN=postgres://squishy:squishy@postgres:5432/squishy?sslmode=disable
SQUISHY_WORKERS=4
SQUISHY_LOG_LEVEL=info
SQUISHY_BATCH_SIZE=10000
SQUISHY_WORKER_ID=api-1
# Optional bearer token required on /api/v1 (unset = open API, keep it on localhost).
SQUISHY_API_TOKEN=
# Browser origins allowed for CORS and state-changing requests.
SQUISHY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host address the compose ports bind to (0.0.0.0 exposes them on the network).
SQUISHY_BIND_ADDR=127.0.0.1
